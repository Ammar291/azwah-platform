{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Safeguarding": {
    "ScoreAlerts": {
      "Enabled": true,
      "Tiers": {
        "household_assessment_total": [ "vulnerable" ]
      }
    }
  },
  "SupportResources": {
    "LanguageModel": {
      "Enabled": false,
      "ApprovalReference": "",
      "TimeoutSeconds": 5,
      "MaxAttempts": 2,
      "MaxCandidates": 12,
      "MaxOutputTokens": 256
    }
  }
}
