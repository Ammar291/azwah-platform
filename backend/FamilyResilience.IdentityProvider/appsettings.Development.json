{
  "IdentityProvider": {
    "Issuer": "http://localhost:5090",
    "Audience": "azwah-api",
    "AccessTokenSeconds": 600,
    "Clients": {
      "azwah-mobile": {
        "Confidential": false,
        "RedirectUris": [ "azwah://auth/callback" ],
        "PostLogoutRedirectUris": [ "azwah://auth/signed-out" ],
        "AllowExpoGoRedirects": true
      },
      "azwah-admin": {
        "Confidential": true,
        "RedirectUris": [ "http://localhost:3000/auth/callback" ],
        "PostLogoutRedirectUris": [ "http://localhost:3000/sign-in?signedOut=1" ]
      }
    }
  }
}
