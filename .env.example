# Copy to .env and replace the values. Never commit .env.
# Every value here is a placeholder; there are no real credentials in this repository.
# Generate each secret below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (or: openssl rand -base64 32)

# --- PostgreSQL (infra/docker-compose.yml) ---
POSTGRES_USER=azwah
# Required: a random local value.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=azwah
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
# true: the Compose API runs against the demonstration database <POSTGRES_DB>_demo, synthetic data only (D-140).
# Build it first with `docker compose --env-file .env -f infra/docker-compose.yml run --rm api db demo`, then set
# true and run `up -d` again (README.md, "Quickstart"). Development only; false uses the ordinary, empty database.
USE_DEMONSTRATION_DATABASE=false
# For `dotnet run`, put this value in user secrets (see backend/README.md); `dotnet run` does not read .env.
ConnectionStrings__Default="Host=localhost;Port=5432;Database=azwah;Username=azwah;Password=change-me-local-only"
# OpenID Connect issuer and audience for `dotnet run` (user secrets, backend/README.md). The Compose API trusts the
# identity provider below by itself. Production UAE PASS is NOT onboarded (D-129).
Authentication__Schemes__Bearer__Authority=
Authentication__Schemes__Bearer__ValidAudiences__0=
# Optional. OpenAI key for the Azwah assistant, the live consultant and the written score report (D-112, D-119). Empty
# keeps them switched off. Local development only: a deployed API takes it from its secret store, with an approval
# reference. The API reads this one variable from .env itself, under Compose and `dotnet run`. OpenAI is not approved
# to receive family data (open questions 48 and 52): use synthetic data only.
OPENAI_API_KEY=
# Optional: send traces, metrics and logs to an OpenTelemetry collector, for example http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Identity provider (infra/docker-compose.yml, service identity-provider) ---
# The platform's OpenID Connect provider (D-129). Compose runs it in Development, where it offers UAE PASS STAGING
# (with the sandbox client below) and simulated personas: anyone can sign in as any test persona and no identity is
# checked. See backend/FamilyResilience.IdentityProvider/README.md. The Compose API trusts it. Production UAE PASS is
# NOT onboarded.
IDENTITY_PROVIDER_PORT=5090
# 127.0.0.1 keeps the provider (a token mint for the local API) off the network. Set 0.0.0.0 only to sign in from a
# phone on the same Wi-Fi, together with a LAN address in IDENTITY_PROVIDER_ISSUER.
IDENTITY_PROVIDER_BIND=127.0.0.1
# Must be reachable under this same URL from every client (browser, emulator or phone, dashboard). Keep its port equal
# to IDENTITY_PROVIDER_PORT.
IDENTITY_PROVIDER_ISSUER=http://localhost:5090
# Required for the dashboard: the client secret of its client `azwah-admin` at the provider (a random local value; it
# protects nothing real). Compose gives the same value to both. Left empty, the dashboard's sign-in fails with
# invalid_client.
IDENTITY_PROVIDER_ADMIN_CLIENT_SECRET=
# Optional. UAE PASS staging sign-in (the app's "Sign in with UAE PASS", and "Continue with UAE PASS (staging)" on the
# provider's page), for UAE PASS STAGING test accounts only; production UAE PASS is refused.
# UAE PASS publishes a public sandbox client for staging proofs of concept (client ID and secret both `sandbox_stage`,
# docs.uaepass.ae); set them here. While either is empty, UAE PASS stays off and only personas work.
IDENTITY_PROVIDER_UAEPASS_ENABLED=true
IDENTITY_PROVIDER_UAEPASS_CLIENT_ID=
IDENTITY_PROVIDER_UAEPASS_CLIENT_SECRET=
# Optional. Google sign-in (the app's "Continue with Google", and "Continue with Google" on the provider's page, D-147),
# with your own Google OAuth client. Create a "Web application" OAuth client in Google Cloud Console with the redirect
# URI {IDENTITY_PROVIDER_ISSUER}/google/callback (http://localhost:5090/google/callback by default) and set its ID and
# secret here. While either is empty, Google stays off and nothing else changes. Never commit the secret.
IDENTITY_PROVIDER_GOOGLE_ENABLED=true
IDENTITY_PROVIDER_GOOGLE_CLIENT_ID=
IDENTITY_PROVIDER_GOOGLE_CLIENT_SECRET=

# --- Admin dashboard (infra/docker-compose.yml, service admin) ---
# http://localhost:<ADMIN_PORT> is the address to open; the provider's return addresses and the API's allowed origin
# follow it. ADMIN_ORIGIN, if set, replaces that whole address (it must be exactly what the browser shows).
ADMIN_PORT=3000
# ADMIN_ORIGIN=http://localhost:3000
# Required for the dashboard: its session cookie key, base64 of at least 32 random bytes (the command at the top).
ADMIN_SESSION_SECRET=
# Running the dashboard with `npm run dev` instead: settings in apps/admin/.env.local, see apps/admin/.env.example.

# --- Mobile (copy into apps/mobile/.env, see apps/mobile/.env.example) ---
# Android emulator: http://10.0.2.2:8080. Physical phone: http://<this computer's LAN IP>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Sign-in: EXPO_PUBLIC_OIDC_ISSUER and EXPO_PUBLIC_OIDC_CLIENT_ID (no secret), explained in apps/mobile/.env.example.
