# Copy to .env. Android emulator: http://10.0.2.2:8080 (Docker Compose) or http://10.0.2.2:5080 (dotnet run).
# Physical phone on the same Wi-Fi: http://<this computer's LAN IP>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Development fixtures mode: simulated sign-in and made-up data from src/dev-fixtures, so every screen works without
# an identity provider. Honoured only in development builds; release builds always use the API. Set to false to use
# the API with the OpenID Connect settings below.
EXPO_PUBLIC_DEV_FIXTURES=true

# Demo buttons (D-130): "Low", "Medium" and "High" on the question screen fill every answer so the result comes out in
# that band. Always shown in fixtures mode; set to true to show them against the API too. The API chooses the answers
# and refuses (404) unless its DemoTools:Enabled is on, which only appsettings.Development.json sets.
EXPO_PUBLIC_DEMO_TOOLS=false

# Demonstration build (D-148): only for a sideloaded release APK that talks to a Development stack (API and identity
# provider in Development, synthetic demonstration data only), for example the owner's laptop behind an HTTPS tunnel.
# Set to true and a release build also accepts an issuer whose discovery says "azwah_development_only", offers its
# "Other sign-in options" (the persona page) and offers "Auto-fill" (the demo family). Nothing else changes: http API
# and issuer addresses and fixtures mode stay refused in a release build. Never set it for a build real families use
# (open question 69, threat T-39). Development builds ignore it (they already allow all three).
EXPO_PUBLIC_DEMONSTRATION_BUILD=

# --- OpenID Connect sign-in (API mode) ---
# Without an issuer and a client ID, sign-in says it is not available. There is no client secret: the app is a public
# client (authorization code with PKCE). Production UAE PASS is NOT onboarded; the Azwah identity provider signs in
# with UAE PASS *staging* (D-96, D-129, see EXPO_PUBLIC_OIDC_IDP_HINT below).
#
# Local development: the platform's identity provider (backend/FamilyResilience.IdentityProvider, port 5090) signs in
# with UAE PASS staging when its sandbox client is set and, in Development, also offers simulated personas (you choose
# a made-up person and no identity is checked). Its Development discovery says "azwah_development_only", which, like
# any http issuer, a release build refuses.
# The issuer must match exactly, so the phone has to reach it as http://localhost:5090:
#   Android emulator or USB phone: adb reverse tcp:5090 tcp:5090 (and adb reverse tcp:8080 tcp:8080 to use
#   EXPO_PUBLIC_API_URL=http://localhost:8080), or opt in to the provider listening on the network
#   (IDENTITY_PROVIDER_BIND=0.0.0.0 in Compose) and set the computer's LAN address as the issuer everywhere
#   (IdentityProvider:Issuer, the API's authority and this value). Release builds also refuse an http EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:5090
EXPO_PUBLIC_OIDC_CLIENT_ID=azwah-mobile
# Optional. Defaults: scope "openid offline_access"; prompt "login" (a shared family phone asks again every time).
EXPO_PUBLIC_OIDC_SCOPE=
EXPO_PUBLIC_OIDC_PROMPT=
# Optional RFC 8707 resource indicator for the API, when the identity provider needs one.
EXPO_PUBLIC_OIDC_RESOURCE=
# The choice is made in the app (D-142). "Sign in with UAE PASS" sends idp_hint=uae_pass with its own request, so the
# Azwah identity provider goes straight to UAE PASS staging when it has it enabled (backend/FamilyResilience.IdentityProvider
# README: IdentityProvider:UaePass with the public sandbox client); otherwise the provider answers temporarily_unavailable.
# Left empty, a development build against the Development provider also offers "Other sign-in options" (the provider's
# persona page, no hint). Set a hint (for example uae_pass) to send every sign-in with it and offer no test accounts;
# set none to send no hint and name no UAE PASS. Signing out of a UAE PASS session also ends the UAE PASS browser
# session through the provider (D-129).
EXPO_PUBLIC_OIDC_IDP_HINT=
