# Copy to .env.local. Every variable is read on the server only; none may start with NEXT_PUBLIC_.
# The browser never calls the API: the dashboard's server forwards allowlisted requests (/bff/...).

# `development` enables the development sign-in and mock data. Any other value, or none, is production.
ADMIN_ENVIRONMENT=development

# ---------------------------------------------------------------------------------------------------------------
# ADMIN_APP_ORIGIN must be EXACTLY the address you open the dashboard at: scheme, host and port, no path.
# It defaults to http://localhost:3000 in development. If you open the dashboard anywhere else (another port because
# 3000 was taken: `next dev` then prints "using available port 3001"; 127.0.0.1 instead of localhost; a LAN address
# or a tunnel for a demonstration), set it to that address and restart the server. Otherwise the dashboard redirects
# sign-in to the configured address, and every state-changing request (development sign-in, sign-out, requesting an
# export, closing a privacy request) is refused as coming from another origin. That check is the CSRF protection and
# is not relaxed in development.
#   ADMIN_APP_ORIGIN=http://localhost:3001
# ---------------------------------------------------------------------------------------------------------------
# ADMIN_APP_ORIGIN=http://localhost:3000

# Session cookie key: base64 of at least 32 random bytes. Required for OIDC and in production; development sign-in
# without it uses a key derived from the origin (its sessions hold only a persona name).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ADMIN_SESSION_SECRET=
# ADMIN_SESSION_MAX_AGE_SECONDS=28800

# Sign-in: `oidc` (default in production) or `development` (default in development; never in production).
ADMIN_AUTH_MODE=development
# OIDC_ISSUER=https://issuer.example.org/realms/azwah
# OIDC_CLIENT_ID=azwah-admin
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid offline_access
# OIDC_RESOURCE=
#
# Real OIDC sign-in in development against the Azwah identity provider (backend/FamilyResilience.IdentityProvider:
# `npm run identity:dev` or Docker Compose; staff sign in with its simulated Development personas, which check no
# identity; a plain-HTTP issuer is accepted only while ADMIN_ENVIRONMENT=development):
#   ADMIN_AUTH_MODE=oidc
#   OIDC_ISSUER=http://localhost:5090
#   OIDC_CLIENT_ID=azwah-admin
#   OIDC_CLIENT_SECRET=<the value of IdentityProvider:Clients:azwah-admin:Secret>
#   ADMIN_SESSION_SECRET=<base64 of 32 random bytes>
#   ADMIN_DATA_SOURCE=api
#   ADMIN_API_URL=http://localhost:8080
# (the Docker Compose API, which trusts this provider: OIDC is the only sign-in that works against it; see the
# development tokens below for the API started with `dotnet run`)
# Production UAE PASS is not onboarded and no staff identity provider is configured for production; the provider's
# UAE PASS staging sign-in is for participants (D-129).

# Data: `api` (default) or `mock` (development sign-in only; synthetic data, labelled on every page).
ADMIN_DATA_SOURCE=mock

# Which synthetic data the mock shows:
#   no_approved_scores (default)  the platform's real state today: no approved scoring rule set, so the analytics
#                                 page and the household results are empty.
#   approved_scores               FOR A DEMONSTRATION: the same households and assignments, with the household
#                                 assessment scored, so the score charts, the wave comparison and the household
#                                 results are filled in. Every number is synthetic and every page says so.
# ADMIN_MOCK_SCENARIO=approved_scores

# With ADMIN_DATA_SOURCE=api: the API's address, and in development one token per persona, minted with
#   cd backend/FamilyResilience.Api && dotnet user-jwts create --role researcher
# These tokens are signed with a key in your user secrets, so they work only against the API started with
# `dotnet run` (http://localhost:5080), NOT against the Docker Compose API (http://localhost:8080), which has no such
# key and answers 401. Against the Compose API, sign in with OIDC instead (see above).
# ADMIN_API_URL=http://localhost:5080
# ADMIN_DEV_TOKEN_RESEARCHER=
# ADMIN_DEV_TOKEN_PROGRAM_ADMINISTRATOR=
# ADMIN_DEV_TOKEN_SYSTEM_ADMINISTRATOR=
# ADMIN_DEV_TOKEN_SUPPORT_COORDINATOR=
